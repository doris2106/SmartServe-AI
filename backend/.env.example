# =====================================================================
# SmartServe AI - Environment Configuration Template
# Placeholders only. Production secrets are loaded from AWS SSM Parameter Store.
# =====================================================================

PORT=5000
NODE_ENV=production
AWS_REGION=eu-north-1

# Database Configuration (Populated from SSM: /smartserve/db/*)
DB_HOST=your-rds-endpoint.eu-north-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=smartserve_db
DB_USER=smartserve_admin
DB_PASSWORD=YOUR_SECURE_PASSWORD

# JWT Secret (Populated from SSM: /smartserve/jwt/secret)
JWT_SECRET=YOUR_JWT_SECRET_KEY

# AWS Storage & Messaging (Populated from SSM: /smartserve/*)
S3_BUCKET=your-attachments-bucket-name
SQS_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/YOUR_ACCOUNT_ID/smartserve-complaint-queue
SNS_TOPIC_ARN=arn:aws:sns:eu-north-1:YOUR_ACCOUNT_ID/smartserve-notifications-topic
